{
  "name": "duel",
  "productName": "duel",
  "version": "0.9.0",
  "private": true,
  "scripts": {
    "preserver": "npm run assets:dev && mkdir -p public/lib && cp templates/index.html public/",
    "server": "concurrently -k \"tsup --watch\" \"serve -l 4000 public dist\"",
    "predist": "npm run assets && mkdir -p public/lib && cp templates/index.html public/",
    "dist": "echo-cli 'Building DIST ...' && DIST=1 tsup && echo-cli 'Build Complete ✔'",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --cache --cache-strategy content 'src/**/*.ts'",
    "lint:fix": "npm run lint -- --fix",
    "lint:full": "npm run lint:fix && npm run typecheck",
    "assets": "tsx ./bin/generate_assets_data.ts",
    "assets:dev": "tsx ./bin/generate_assets_data.ts --dev",
    "sim": "tsx ./bin/balance-sim.ts",
    "sim:search": "tsx ./bin/search-rules.ts",
    "sim:fun": "tsx ./bin/search-fun.ts",
    "sim:space": "tsx ./bin/search-space.ts",
    "sim:catalog": "tsx ./bin/search-catalog.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flesler/duel.git"
  },
  "author": "Ariel Flesler <https://github.com/flesler>",
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@stylistic/eslint-plugin": "^4.2.0",
    "@types/node": "^24.0.0",
    "@types/shelljs": "^0.10.0",
    "@typescript-eslint/eslint-plugin": "^8.30.0",
    "@typescript-eslint/parser": "^8.30.0",
    "commander": "^11.1.0",
    "concurrently": "^9.2.1",
    "echo-cli": "^1.0.8",
    "eslint": "^9.30.0",
    "serve": "^14.2.1",
    "shelljs": "^0.10.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "webfontloader": "^1.6.28"
  },
  "dependencies": {
    "phaser": "^4.2.1"
  }
}
