{
  "name": "duel",
  "productName": "duel",
  "version": "0.9.0",
  "private": true,
  "scripts": {
    "preserver": "npm run assets:dev && mkdir -p public/lib && cp templates/index.html public/",
    "server": "concurrently -k \"npm run build:watch\" \"serve -l 4000 public dist\"",
    "prebuild": "npm run assets && mkdir -p public/lib && cp templates/index.html public/",
    "build": "echo-cli 'Building ...' && DIST=1 tsup && echo-cli 'Build Complete ✔'",
    "build:watch": "tsup --watch",
    "build:clear": "rm -rf dist/*",
    "dist": "npm run build",
    "eslint": "eslint --cache --cache-strategy content",
    "lint": "npm run eslint -- '{src,bin}/**/*.ts'",
    "lint:fix": "npm run lint -- --fix",
    "test:types:src": "tsc -p tsconfig.build.json --incremental --tsBuildInfoFile dist/src.tsbuildinfo",
    "test:types:test": "tsc -p tsconfig.test.json --incremental --tsBuildInfoFile dist/test.tsbuildinfo",
    "test:types:bin": "tsc -p bin/tsconfig.json --incremental --tsBuildInfoFile dist/bin.tsbuildinfo",
    "test:types": "npm run test:types:src && npm run test:types:test && npm run test:types:bin",
    "lint:full": "npm run test:types && npm run lint:fix",
    "lint:full:silent": "npm run -s lint:full && echo LINT OK",
    "agent:stop": "npm run -s lint:full:silent",
    "assets": "tsx ./bin/generate_assets_data.ts",
    "assets:dev": "tsx ./bin/generate_assets_data.ts --dev",
    "sim": "tsx ./bin/balance-sim.ts",
    "sim:search": "tsx ./bin/search-rules.ts",
    "sim:fun": "tsx ./bin/search-fun.ts",
    "sim:space": "tsx ./bin/search-space.ts",
    "sim:catalog": "tsx ./bin/search-catalog.ts",
    "vitest": "VITE_CJS_IGNORE_WARNING=true vitest",
    "test": "npm run test:types && npm run test:unit",
    "test:unit": "npm run vitest -- run",
    "test:unit:min": "MINIMAL=1 npm run test:unit",
    "test:unit:verbose": "VERBOSE=1 npm run test:unit",
    "test:watch": "npm run vitest -- --watch",
    "prepare": "[ \"$CI\" != \"true\" ] && [ -d node_modules/husky ] && husky || true",
    "changelog": "auto-changelog --commit-limit 100 --hide-credit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flesler/duel.git"
  },
  "author": "Ariel Flesler <https://github.com/flesler>",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^24.13.3",
    "@types/shelljs": "^0.10.0",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "commander": "^11.1.0",
    "concurrently": "^9.2.1",
    "echo-cli": "^1.0.8",
    "eslint": "^10.9.1",
    "eslint-plugin-import-newlines": "^2.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "serve": "^14.2.1",
    "shelljs": "^0.10.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "webfontloader": "^1.6.28",
    "auto-changelog": "^2.6.0"
  },
  "dependencies": {
    "phaser": "^4.2.1"
  }
}
